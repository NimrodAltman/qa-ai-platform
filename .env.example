# Copy this file to .env and fill in your key. .env is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: which Claude model the agent uses. Default: claude-opus-5.
# Cheaper options for testing: claude-sonnet-5, claude-haiku-4-5.
# QA_MODEL=claude-sonnet-5

# Optional: secret key signing the web UI's login session cookie. If unset,
# a random key is generated each time the server starts, so everyone's
# session is invalidated on every restart. Set a fixed value (e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`) to keep
# sessions alive across restarts — required for anything beyond local/demo
# use, and keep the value out of git either way.
# SESSION_SECRET=
