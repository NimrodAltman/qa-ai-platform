# Copy this file to .env and fill in your key. .env is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: which Claude model the agent uses. Default: claude-opus-5.
# Cheaper options for testing: claude-sonnet-5, claude-haiku-4-5.
# QA_MODEL=claude-sonnet-5

# Optional: secret key signing the web UI's login session cookie. Set this to
# a random string for any real deployment — the built-in fallback is fine for
# local single-user use but is NOT secret (it's in the source code).
# SESSION_SECRET=
